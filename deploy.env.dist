# Copier en deploy.env.local (non versionné) pour bin/deployer et bin/sauvegardes. Voir docs/deploiement.md.

# serveur (alias SSH de ~/.ssh/config, connexion par clé)
SSH_HOTE=vps-ovh
# nom du site sur le serveur (celui donné à `nouveau-site`) : dossier /srv/sites/<SITE>, utilisateur s-<SITE>
SITE=data
# adresse publique du site, vérifiée après le déploiement
URL_SITE=https://data.vincent-trotot.fr
# page vérifiée (doit répondre 200)
CHEMIN_VERIF=/login
# dossiers gardés d'une version à l'autre (dans shared/) : aucun ici
PARTAGES=
# optionnel, avant la bascule DNS : IP du VPS à viser directement pour la vérification
#IP_VERIF=
